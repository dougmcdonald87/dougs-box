// tailscale-grants.example.hujson
//
// MERGEABLE FRAGMENT: paste/merge into the grants file in the Tailscale admin console
// (Access controls). Contains no secrets ever.
//
// Meaning:
//   - the OWNER (own devices) may open RDP (TCP 3389) to DevBox nodes;
//   - DevBox nodes reach ONLY the storage host on TCP 8000 (rest-server, plain HTTP) and,
//     only if SMB is enabled in the storage-host config, TCP 445;
//   - everything else is denied by omission: no broad tailnet access for the DevBox.
{
  "grants": [
    {
      "src": ["autogroup:member"],
      "dst": ["tag:github-devbox"],
      "ip": ["tcp://3389"]
    },
    {
      "src": ["tag:github-devbox"],
      "dst": ["tag:devbox-storage"],
      "ip": [
        "tcp://8000",
        "tcp://445"
      ]
    }
  ]
}
