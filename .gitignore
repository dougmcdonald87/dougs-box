# DevBox repository hygiene. Secrets NEVER live here.
# OS junk
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Editor/state droppings
*.swp
.vs/
.idea/
.vscode/

# Disposable build artefacts
node_modules/
.venv/
__pycache__/
bin/
obj/
target/
dist/
build/

# Anything secret-shaped that must never be committed, as belt-and-braces
# (the real gate is the validate.yml secret scan)
*.pem
*.pfx
*.p12
*.key
*.pem.tmp
*_rsa
*_ed25519
htpasswd
htpasswd.txt
auth_state_key.json
*.restic-password*
restic-password*.txt

# Local runtime copies of the example configs (owner fills these on the host)
config/devbox.json
config/persistence.json
security/tailscale-grants.hujson
